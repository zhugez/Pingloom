{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pingloom",
  "version": "0.2.1",
  "identifier": "com.lolping.desktop",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "capabilities": ["settings-window"],
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
